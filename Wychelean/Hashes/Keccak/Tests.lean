private def encodeBits (bits : Vector Bool n) : String :=
  Hex.encode ((Array.range ((n + 7) / 8)).map fun i =>
    (List.range 8).foldl (fun (acc : UInt8) j =>
      acc ||| ((if bits.toArray[i*8+j]?.getD false then 1 else 0) <<< j.toUInt8)) 0)

private def checkSponge (v : SpongeVector) : Test :=
  let raw := (hexBytes v.input).toArray
  let name := s!"b={b v.width}, r={v.rate}, n={v.inputBits}"
  if h : v.inputBits ≤ 8 * raw.size then
    if hr : 0 < v.rate ∧ v.rate < b v.width then
      let input := (SHA3.Rsp.BitString.mk v.inputBits raw h).bits
      check name v.output (encodeBits (KECCAK v.width v.rounds v.rate input v.outputBits hr))
    else ⟨name, some "invalid rate"⟩
  else ⟨name, some "invalid input length"⟩

private def checkPermutation (v : PermutationVector) : Test :=
  let raw := (hexBytes v.input).toArray
  if h : b v.width ≤ 8 * raw.size then
    let input := (SHA3.Rsp.BitString.mk (b v.width) raw h).bits
    let output := KECCAK_p v.width v.rounds input
    let bytes := (Array.range ((b v.width + 7) / 8)).map fun i =>
      (List.range 8).foldl (fun (acc : UInt8) j =>
        acc ||| ((if output.toArray[i*8+j]?.getD false then 1 else 0) <<< j.toUInt8)) 0
    check v.name v.output (Hex.encode bytes)
  else ⟨v.name, some "invalid input width"⟩

/-- All widths, zero/reduced/full/extra rounds. Generated cases use the independent bit-level
FIPS transcription in Fixtures/generate.py, cross-checked against the published traces. -/
private def permutations : Suite where
  name := "Keccak published and independent permutation vectors"
  tests := pure ((published ++ generated).map checkPermutation)

private def sponges : Suite where
  name := "Keccak general sponge boundaries"
  tests := pure (spongeVectors.map checkSponge)

def suites : List Suite := [permutations, sponges]

end Wychelean.Hashes.Keccak.Tests
