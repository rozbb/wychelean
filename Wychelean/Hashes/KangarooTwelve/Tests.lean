private def runVector (v : XofVector) : IO Test := do
  let msg := if v.messageFF then Array.replicate v.messageLength (255 : UInt8) else pattern v.messageLength
  let custom := pattern v.customizationLength
  let result ← match v.function with
    | .TurboSHAKE128 | .TurboSHAKE256 => do
      let D := UInt8.ofNat v.domain
      if h : 0 < D.toNat ∧ D.toNat < 128 then
        match v.function with
        | .TurboSHAKE128 => pure (TurboSHAKE.TurboSHAKE128 msg.toVector v.outputLength ⟨D,h⟩)
        | _ => pure (TurboSHAKE.TurboSHAKE256 msg.toVector v.outputLength ⟨D,h⟩)
      else throw (IO.userError s!"{v.name}: invalid domain")
    | .KT128 | .KT256 => do
      if hC : custom.size < lengthLimit then
        if hCount : chainingValueCount msg.size custom.size < lengthLimit then
          match v.function with
          | .KT128 => pure (KT128 msg.toVector custom.toVector v.outputLength hC hCount)
          | _ => pure (KT256 msg.toVector custom.toVector v.outputLength hC hCount)
        else throw (IO.userError s!"{v.name}: too many chunks")
      else throw (IO.userError s!"{v.name}: customization too large")
  return check v.name v.expected (Hex.encode (result.toArray.extract v.offset v.outputLength))

private def rfc : Suite where
  name := "RFC 9861 TurboSHAKE and KangarooTwelve (all 67 vectors)"
  tests := rfcCases.mapM runVector

private def lengths : Suite where
  name := "KangarooTwelve length_encode (RFC 9861 §3.3)"
  tests := pure [
    check "0" "00" (Hex.encode (length_encode 0 (by decide)).toArray),
    check "12" "0c01" (Hex.encode (length_encode 12 (by decide)).toArray),
    check "65538" "01000203" (Hex.encode (length_encode 65538 (by decide)).toArray),
    check "255" "ff01" (Hex.encode (length_encode 255 (by decide)).toArray),
    check "256" "010002" (Hex.encode (length_encode 256 (by decide)).toArray)
  ]

private def boundaries : Suite where
  name := "TurboSHAKE and KangarooTwelve boundary vectors (pinned XKCP/K12 reference)"
  tests := boundaryCases.mapM runVector

def suites : List Suite := [lengths, rfc, boundaries]

end Wychelean.Hashes.KangarooTwelve.Tests
