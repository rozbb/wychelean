private def checkPermutation (v : PermutationVector) : Test :=
  let raw := (hexBytes v.input).toArray
  if h : b v.width ≤ 8 * raw.size then
    let input := (Wychelean.Hashes.SHA3.Rsp.BitString.mk (b v.width) raw h).bits
    let output := keccak_p v.width v.rounds input
    let bytes := (Array.range ((b v.width + 7) / 8)).map fun i =>
      (List.range 8).foldl (fun (acc : UInt8) j =>
        acc ||| ((if output.toArray[i*8+j]?.getD false then 1 else 0) <<< j.toUInt8)) 0
    check v.name v.output (Hex.encode bytes)
  else ⟨v.name, some "invalid input width"⟩

/-- All widths, zero/reduced/full/extra rounds. Generated cases use the independent bit-level
FIPS transcription in Fixtures/generate.py, cross-checked against the published traces. -/
private def permutations : Suite where
  name := "Keccak published and independent permutation vectors"
  tests := pure ((published ++ generated).map checkPermutation)

def suites : List Suite := [permutations]

end Wychelean.Permutations.Keccak.Tests
